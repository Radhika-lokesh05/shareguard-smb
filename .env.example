# ShareGuard – Environment Configuration Template
# Copy this file to .env and customize with secure random values.
# NEVER commit .env to version control.

# Server Mode: "simulation" (developer/test) or "live" (production Linux Samba)
SHAREGUARD_MODE=simulation
SHAREGUARD_SERVER_HOST=127.0.0.1
SHAREGUARD_SERVER_PORT=8000

# Authentication & Keys
# In LIVE mode, SHAREGUARD_ADMIN_KEY must be a cryptographically random secret (min 16 chars).
# Example generation: openssl rand -hex 32
SHAREGUARD_ADMIN_KEY=change-this-in-production-to-a-secure-secret-min-16-chars
SHAREGUARD_VIEWER_KEY=viewer-read-only-secret-key-32chars

# Admin & Viewer Credentials (for web dashboard login)
SHAREGUARD_ADMIN_USER=admin
# Passwords can be plain or formatted as pbkdf2:sha256:100000$<salt>$<hash> or $2b$... bcrypt
SHAREGUARD_ADMIN_PASSWORD=change-admin-password-immediately
SHAREGUARD_VIEWER_USER=viewer
SHAREGUARD_VIEWER_PASSWORD=change-viewer-password-immediately

# Samba Server Settings
SHAREGUARD_SHARE_ROOT=/srv/samba/share
SHAREGUARD_AUDIT_LOG_PATH=/var/log/samba/audit.log

# Assistant (LLM) Integration (Optional)
SHAREGUARD_ASSISTANT_PROVIDER=none
SHAREGUARD_ASSISTANT_API_KEY=
